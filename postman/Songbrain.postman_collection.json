{
  "info": {
    "name": "Songbrain API",
    "_postman_id": "2b0f3d2e-7c1a-4f0e-9b8d-5e6a1c4d7f90",
    "description": "Song in, video plan out. The Songbrain API v1: song DNA, beat grid, best moments, timed lyrics, story and a beat-synced shot plan.\n\n1. Set the collection variable `apiKey` to your key (`sb_live_…`, https://app.songbrain.ai/developers). The Examples folder, Pricing and Status need no key.\n2. Start with **Songs → Create song (test mode)**: free, no audio, done right away.\n\nEvery response has a `Songbrain-Request-Id` header; requests with a key also return `X-RateLimit-Limit`, `X-RateLimit-Remaining` and `X-RateLimit-Reset`. Errors look like `{\"error\": {\"code\", \"message\", \"request_id\"}}`.\n\nDocs: https://www.songbrain.ai/docs/api · OpenAPI: https://api.songbrain.ai/v1/openapi.json · Changelog: https://www.songbrain.ai/docs/api/changelog",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.songbrain.ai/v1",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "",
      "type": "string",
      "description": "sb_live_… from https://app.songbrain.ai/developers"
    },
    {
      "key": "songId",
      "value": "",
      "type": "string",
      "description": "Set automatically by the create requests."
    },
    {
      "key": "nextCursor",
      "value": "",
      "type": "string",
      "description": "Set automatically by List songs."
    },
    {
      "key": "exampleId",
      "value": "sugar-rush",
      "type": "string"
    },
    {
      "key": "webhookUrl",
      "value": "https://example.com/songbrain",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Examples (no key)",
      "description": "Real analyses of Songbrain's own songs, in exactly the format your songs get.",
      "item": [
        {
          "name": "List examples",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/examples",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "examples"
              ]
            },
            "description": "All example analyses.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Get example",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/examples/{{exampleId}}?",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "examples",
                "{{exampleId}}"
              ],
              "query": [
                {
                  "key": "view",
                  "value": "summary",
                  "disabled": true,
                  "description": "summary drops word timings and beat arrays"
                },
                {
                  "key": "include",
                  "value": "song_dna,shot_plan",
                  "disabled": true,
                  "description": "only these sections"
                }
              ]
            },
            "description": "A full example document (same format as Get song).",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Get example shot plan",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/examples/{{exampleId}}/shot-plan",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "examples",
                "{{exampleId}}",
                "shot-plan"
              ]
            },
            "description": "Story and shot plan of an example.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Songs",
      "item": [
        {
          "name": "Create song (test mode)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Retries with the same key return the same song (24 h). Postman makes a new one per send."
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/songs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "songs"
              ]
            },
            "description": "Free, no audio needed, never charged. The song is done right away and returns the Sugar Rush analysis with `livemode: false` and `billing.type = \"test\"`. Made for CI.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"test\": true,\n  \"title\": \"Postman test\",\n  \"external_ref\": \"postman-1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.id) pm.collectionVariables.set('songId', body.id);",
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create song from URL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Retries with the same key return the same song (24 h). Postman makes a new one per send."
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/songs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "songs"
              ]
            },
            "description": "Analyse a public audio URL. 202 with `{id, status: \"processing\", eta_sec, billing}`. Takes 60-90 s.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"audio_url\": \"https://example.com/song.mp3\",\n  \"title\": \"My Song\",\n  \"artist\": \"Me\",\n  \"external_ref\": \"my-id-123\",\n  \"webhook_url\": \"{{webhookUrl}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.id) pm.collectionVariables.set('songId', body.id);",
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create song (upload)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Retries with the same key return the same song (24 h). Postman makes a new one per send."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/songs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "songs"
              ]
            },
            "description": "Upload a file (MP3, WAV, FLAC, M4A, AAC, OGG or AIFF, up to 100 MB, 30 s to 10 min). Pick the file in the Body tab.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "title",
                  "value": "My Song",
                  "type": "text"
                },
                {
                  "key": "external_ref",
                  "value": "my-id-123",
                  "type": "text",
                  "disabled": true
                },
                {
                  "key": "webhook_url",
                  "value": "{{webhookUrl}}",
                  "type": "text",
                  "disabled": true
                },
                {
                  "key": "test",
                  "value": "true",
                  "type": "text",
                  "disabled": true
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.id) pm.collectionVariables.set('songId', body.id);",
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get song",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/songs/{{songId}}?",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "songs",
                "{{songId}}"
              ],
              "query": [
                {
                  "key": "view",
                  "value": "summary",
                  "disabled": true,
                  "description": "summary drops word timings and beat arrays"
                },
                {
                  "key": "include",
                  "value": "song_dna,shot_plan",
                  "disabled": true,
                  "description": "only these sections"
                }
              ]
            },
            "description": "While processing: `{status: \"processing\", progress, eta_sec}`. Then the full document."
          }
        },
        {
          "name": "Get shot plan",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/songs/{{songId}}/shot-plan",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "songs",
                "{{songId}}",
                "shot-plan"
              ]
            },
            "description": "Only the story and the shot plan."
          }
        },
        {
          "name": "List songs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/songs?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "songs"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "starting_after",
                  "value": "{{nextCursor}}",
                  "disabled": true
                }
              ]
            },
            "description": "Newest first. Pass `next_cursor` as `starting_after` for the next page (the test script saves it to `nextCursor`)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('nextCursor', body.next_cursor || '');",
                  "pm.test('has_more is a boolean', () => pm.expect(body.has_more).to.be.a('boolean'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List songs (next page)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/songs?limit=20&starting_after={{nextCursor}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "songs"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "starting_after",
                  "value": "{{nextCursor}}"
                }
              ]
            },
            "description": "The page after `nextCursor`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('nextCursor', body.next_cursor || '');"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete song",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/songs/{{songId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "songs",
                "{{songId}}"
              ]
            },
            "description": "Deletes audio and analysis now. 409 `still_processing` while it runs."
          }
        }
      ]
    },
    {
      "name": "Webhooks",
      "item": [
        {
          "name": "Send test ping",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/webhooks/test",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhooks",
                "test"
              ]
            },
            "description": "Sends a signed `ping` event to the URL right now: `{delivered, status_code, latency_ms, event_id}`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"{{webhookUrl}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List deliveries",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/webhooks/deliveries?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhooks",
                "deliveries"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "The last delivery attempts: event_id, type, song_id, url, attempt, status_code, delivered, latency_ms, created_at."
          }
        }
      ]
    },
    {
      "name": "Account & status",
      "item": [
        {
          "name": "Account",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/account",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "account"
              ]
            },
            "description": "Free songs left this month, credit balance and price per song."
          }
        },
        {
          "name": "Pricing",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pricing",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pricing"
              ]
            },
            "description": "Prices and limits. No key needed.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "status"
              ]
            },
            "description": "Public status: api, pipeline, webhooks, queue and median analysis time. No key needed.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    }
  ]
}
